{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fitness-equipment-manager",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "observability": {
    "enabled": true,
  },
  "durable_objects": {
    "bindings": [{ "name": "CHAT_ROOM", "class_name": "ChatRoom" }],
  },
  "migrations": [
    { "tag": "chat-realtime-v1", "new_sqlite_classes": ["ChatRoom"] },
  ],
  "preview_urls": false,
  "vars": {
    "ENVIRONMENT": "development",
    "ALLOWED_EMAILS": "",
    "AI_MODEL": "",
    "AI_BASE_URL": "",
    "MAX_UPLOAD_MB": "10",
    "BUSINESS_TIMEZONE": "Asia/Bangkok",
    "PUBLIC_CATALOG_BASE_URL": "",
    "GMAIL_MAILBOX": "",
    "AUTH_ADMIN_EMAIL": "",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fitness-equipment-manager",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "PRODUCT_IMAGES",
      "bucket_name": "fitness-equipment-manager-images",
    },
  ],
  "env": {
    "production": {
      "name": "fitness-equipment-manager",
      "workers_dev": true,
      "triggers": { "crons": ["*/5 * * * *"] },
      "preview_urls": false,
      "routes": [{ "pattern": "management.corevityusedgym.com", "custom_domain": true }],
      "durable_objects": {
        "bindings": [{ "name": "CHAT_ROOM", "class_name": "ChatRoom" }],
      },
      "vars": {
        "ENVIRONMENT": "production",
        "APP_URL": "https://management.corevityusedgym.com",
        "AUTH_ADMIN_EMAIL": "analyziie@gmail.com",
        "ALLOWED_EMAILS": "analyziie@gmail.com,vorada.chun@gmail.com,ketsalyn.p@gmail.com",
        "AI_MODEL": "gpt-4.1-mini",
        "AI_BASE_URL": "https://api.openai.com/v1",
        "MAX_UPLOAD_MB": "10",
        "BUSINESS_TIMEZONE": "Asia/Bangkok",
        "PUBLIC_CATALOG_BASE_URL": "https://catalog.corevityusedgym.com",
        "GMAIL_MAILBOX": "info@corevityusedgym.com",
        "META_INTEGRATION_ENABLED": "true",
        "META_DEMO_MODE": "false",
        "META_MESSENGER_ENABLED": "true",
        "META_LEADS_ENABLED": "false",
        "META_ADS_READ_ENABLED": "true",
        "META_ADS_WRITE_ENABLED": "false",
        "META_AI_ENABLED": "true",
        "META_PAGE_CONTENT_ENABLED": "false",
        "META_APP_ID": "1056201947478275",
        "META_LOGIN_CONFIG_ID": "1391760923120497",
        "META_GRAPH_API_VERSION": "v26.0",
        "META_OAUTH_REDIRECT_URL": "https://management.corevityusedgym.com/api/integrations/meta/callback",
        "META_TOKEN_ENCRYPTION_KEY_VERSION": "meta-2026-10-18",
        "META_LIVE_ACTIVATION_CONFIRMED": "true",
        "META_PAGE_SCHEDULING_SUPPORTED": "false",
        "META_DATA_RETENTION_DAYS": "90",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "fitness-equipment-manager",
          "database_id": "de34955b-5a97-47a9-9169-3dbed136cb75",
          "migrations_dir": "drizzle/migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "PRODUCT_IMAGES",
          "bucket_name": "fitness-equipment-manager-images",
        },
      ],
    },
  },
  "account_id": "7e8a63993a65056ced687bb043f254ca",
}
