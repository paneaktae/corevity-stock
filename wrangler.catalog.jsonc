{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fitness-equipment-catalog",
  "main": "worker/public-catalog.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    "PUBLIC_CATALOG_BASE_URL": "https://fitness-equipment-catalog.analyziie.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fitness-equipment-manager",
      "database_id": "de34955b-5a97-47a9-9169-3dbed136cb75",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PRODUCT_IMAGES",
      "bucket_name": "fitness-equipment-manager-images"
    }
  ],
  "account_id": "7e8a63993a65056ced687bb043f254ca"
}
